msgid "\"short-vis-path\""
msgstr ""

#: src/to-contribute/coding-guidelines/for-maintainability/rust-specific/naming.md:11
#: src/to-contribute/coding-guidelines/for-maintainability/rust-specific/naming.md:28
msgid "// Bad\n"
msgstr ""

#: src/to-contribute/coding-guidelines/for-maintainability/rust-specific/naming.md:14
msgid "\"short_vis_path\""
msgstr ""

#: src/to-contribute/coding-guidelines/for-maintainability/rust-specific/naming.md:17
msgid ""
"Follow Rust CamelCase and acronym capitalization (`camel-case-acronyms`)"
msgstr ""

#: src/to-contribute/coding-guidelines/for-maintainability/rust-specific/naming.md:19
msgid ""
"Type names follow Rust's CamelCase convention. Acronyms are title-cased per "
"the Rust API Guidelines:"
msgstr ""

#: src/to-contribute/coding-guidelines/for-maintainability/rust-specific/naming.md:36
msgid "End closure variables with `_fn` (`closure-fn-suffix`)"
msgstr ""

#: src/to-contribute/coding-guidelines/for-maintainability/rust-specific/naming.md:38
msgid ""
"Variables holding closures or function pointers must signal they are "
"callable by ending with `_fn`. Treating a closure variable as if it were a "
"data object misleads readers."
msgstr ""

#: src/to-contribute/coding-guidelines/for-maintainability/rust-specific/naming.md:44
msgid "// Good — clearly a callable\n"
msgstr ""

