#: src/to-contribute/coding-guidelines/for-maintainability/rust-specific/naming.md:1
msgid "Naming"
msgstr ""

#: src/to-contribute/coding-guidelines/for-maintainability/rust-specific/naming.md:3
msgid "Create crates with kebab-case names (`kebab-case-crate-names`)"
msgstr ""

#: src/to-contribute/coding-guidelines/for-maintainability/rust-specific/naming.md:5
msgid ""
"Asterinas prefers kebab-case for crate names, which is unspecified in "
"official Rust API Guidelines."
msgstr ""

#: src/to-contribute/coding-guidelines/for-maintainability/rust-specific/naming.md:8
#: src/to-contribute/coding-guidelines/for-maintainability/rust-specific/naming.md:23
msgid "// Good\n"
msgstr ""

