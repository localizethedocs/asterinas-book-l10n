msgid "Value"
msgstr ""

#: src/kernel/linux-compatibility/kernel-parameters.md:88
msgid "Name(s)"
msgstr ""

#: src/kernel/linux-compatibility/kernel-parameters.md:88
msgid "Messages shown"
msgstr ""

