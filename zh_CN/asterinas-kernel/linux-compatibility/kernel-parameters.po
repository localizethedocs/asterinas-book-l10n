msgstr ""

#: src/kernel/linux-compatibility/kernel-parameters.md:91
msgid "`emerg`"
msgstr ""

#: src/kernel/linux-compatibility/kernel-parameters.md:91
msgid "Emerg only"
msgstr ""

#: src/kernel/linux-compatibility/kernel-parameters.md:92
msgid "`2`"
msgstr ""

#: src/kernel/linux-compatibility/kernel-parameters.md:92
msgid "`alert`"
msgstr ""

#: src/kernel/linux-compatibility/kernel-parameters.md:92
msgid "Emerg through Alert"
msgstr ""

#: src/kernel/linux-compatibility/kernel-parameters.md:93
msgid "`3`"
msgstr ""

#: src/kernel/linux-compatibility/kernel-parameters.md:93
msgid "`crit`"
msgstr ""

#: src/kernel/linux-compatibility/kernel-parameters.md:93
msgid "Emerg through Crit"
msgstr ""

#: src/kernel/linux-compatibility/kernel-parameters.md:94
msgid "`4`"
msgstr ""

#: src/kernel/linux-compatibility/kernel-parameters.md:94
msgid "`error`, `err`"
msgstr ""

#: src/kernel/linux-compatibility/kernel-parameters.md:94
msgid "Emerg through Error"
msgstr ""

#: src/kernel/linux-compatibility/kernel-parameters.md:95
msgid "`5`"
msgstr ""

#: src/kernel/linux-compatibility/kernel-parameters.md:95
msgid "`warning`, `warn`"
msgstr ""

#: src/kernel/linux-compatibility/kernel-parameters.md:95
msgid "Emerg through Warning"
msgstr ""

#: src/kernel/linux-compatibility/kernel-parameters.md:96
msgid "`6`"
msgstr ""

#: src/kernel/linux-compatibility/kernel-parameters.md:96
msgid "`notice`"
msgstr ""

#: src/kernel/linux-compatibility/kernel-parameters.md:96
msgid "Emerg through Notice"
msgstr ""

#: src/kernel/linux-compatibility/kernel-parameters.md:97
msgid "`7`"
msgstr ""

#: src/kernel/linux-compatibility/kernel-parameters.md:97
msgid "`info`"
msgstr ""

#: src/kernel/linux-compatibility/kernel-parameters.md:97
msgid "Emerg through Info"
msgstr ""

#: src/kernel/linux-compatibility/kernel-parameters.md:98
msgid "`8`"
msgstr ""

#: src/kernel/linux-compatibility/kernel-parameters.md:98
msgid "`debug`"
msgstr ""

#: src/kernel/linux-compatibility/kernel-parameters.md:98
msgid "All levels (most verbose)"
msgstr ""

#: src/kernel/linux-compatibility/kernel-parameters.md:107
msgid "Level names are case-sensitive; use lowercase names."
msgstr ""

#: src/kernel/linux-compatibility/kernel-parameters.md:108
msgid "If omitted, the default is `8` (`debug`). Invalid values are ignored."
msgstr ""

#: src/kernel/linux-compatibility/kernel-parameters.md:109
msgid ""
"Use `warn` for normal operation, `info`/`debug` when troubleshooting, and "
"`error` or lower for a quieter console."
msgstr ""

#: src/kernel/linux-compatibility/kernel-parameters.md:114
msgid "`i8042.exist`"
msgstr ""

#: src/kernel/linux-compatibility/kernel-parameters.md:116
msgid "Override ACPI's indication of whether a PS/2 (i8042) controller exists."
msgstr ""

#: src/kernel/linux-compatibility/kernel-parameters.md:119
msgid ""
"`1`, `on`, `yes`, `true` or no value — treat the i8042 controller as present "
"(force probing)"
msgstr ""

#: src/kernel/linux-compatibility/kernel-parameters.md:120
msgid ""
"`0`, `off`, `no`, `false` - treat the i8042 controller as absent (skip "
"probing)"
msgstr ""
